<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.2.1</Version>
  <Author>Kees Jan Koster</Author>
 </Creator>
 <Manufacturer>Tensegrity</Manufacturer>
 <Model>Ball</Model>
 <Type>Other</Type>
 <Channel Name="Status LED">
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="255">Level</Capability>
 </Channel>
 <Channel Name="White LED" Preset="IntensityWhite"/>
 <Channel Name="Blue LED" Preset="IntensityBlue"/>
 <Channel Name="Motor">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="127" Preset="NoFunction">Off</Capability>
  <Capability Min="128" Max="255">On</Capability>
 </Channel>
 <Channel Name="Pattern">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="84" Preset="NoFunction">Direct</Capability>
  <Capability Min="85" Max="169">Pulse</Capability>
  <Capability Min="170" Max="255">Strobe</Capability>
 </Channel>
 <Channel Name="Strobe flash">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Length</Capability>
 </Channel>
 <Channel Name="Strobe gap">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Length</Capability>
 </Channel>
 <Mode Name="7 Channel">
  <Channel Number="0">Status LED</Channel>
  <Channel Number="1">White LED</Channel>
  <Channel Number="2">Blue LED</Channel>
  <Channel Number="3">Motor</Channel>
  <Channel Number="4">Pattern</Channel>
  <Channel Number="5">Strobe flash</Channel>
  <Channel Number="6">Strobe gap</Channel>
  <Head>
   <Channel>1</Channel>
   <Channel>2</Channel>
  </Head>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="0" Width="0" Height="0" Depth="0"/>
  <Lens Name="Other" DegreesMin="0" DegreesMax="0"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="0" DmxConnector="Other"/>
 </Physical>
</FixtureDefinition>
