<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.2.1</Version>
  <Author>Kees Jan Koster</Author>
 </Creator>
 <Manufacturer>Tensegrity</Manufacturer>
 <Model>Ball</Model>
 <Type>Other</Type>
 <Channel Name="Onboard LED" Preset="IntensityDimmer"/>
 <Channel Name="led-white" Preset="IntensityWhite"/>
 <Channel Name="led-tbd" Preset="IntensityDimmer"/>
 <Channel Name="Motor time coarse">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Motor run time, high byte (25.6 s per step)</Capability>
 </Channel>
 <Channel Name="Motor time fine">
  <Group Byte="1">Speed</Group>
  <Capability Min="0" Max="255">Motor run time, low byte (0.1 s per step)</Capability>
 </Channel>
 <Channel Name="Keep awake">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="0">Sleep (reserved, not implemented)</Capability>
  <Capability Min="1" Max="255">Stay awake 1-255 s after last packet (reserved, not implemented)</Capability>
 </Channel>
 <Mode Name="6 channel">
  <Channel Number="0">Onboard LED</Channel>
  <Channel Number="1">led-white</Channel>
  <Channel Number="2">led-tbd</Channel>
  <Channel Number="3">Motor time coarse</Channel>
  <Channel Number="4">Motor time fine</Channel>
  <Channel Number="5">Keep awake</Channel>
  <Head>
   <Channel>1</Channel>
   <Channel>2</Channel>
  </Head>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="0" Width="0" Height="0" Depth="0"/>
  <Lens Name="Other" DegreesMin="0" DegreesMax="0"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="0" DmxConnector="Other"/>
 </Physical>
</FixtureDefinition>
