<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.2.1</Version>
  <Author>Kees Jan Koster</Author>
 </Creator>
 <Manufacturer>CLF</Manufacturer>
 <Model>Yara</Model>
 <Type>Color Changer</Type>
 <!-- Outdoor IP65 RGBW par, 14 high-power LEDs. Channel tables transcribed from the
      "DMX protocols" section of the CLF Yara manual, V1.0 December 2016.

      The fixture's CONTROL MODE menu defaults to 11CH; a patch that assumes any other
      mode has to be matched on the fixture's own LCD. -->
 <Channel Name="Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="Shutter">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="24" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="25" Max="64" Preset="StrobeFastToSlow">Strobe 1 (fast -&gt; slow)</Capability>
  <Capability Min="65" Max="69" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="70" Max="84" Preset="PulseFastToSlow">Strobe 2: opening pulse (fast -&gt; slow)</Capability>
  <Capability Min="85" Max="89" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="90" Max="104" Preset="PulseFastToSlow">Strobe 3: closing pulse (fast -&gt; slow)</Capability>
  <Capability Min="105" Max="109" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="110" Max="124" Preset="StrobeRandomFastToSlow">Strobe 4: random strobe (fast -&gt; slow)</Capability>
  <Capability Min="125" Max="129" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="130" Max="144" Preset="StrobeRandomFastToSlow">Strobe 5: random opening pulse (fast -&gt; slow)</Capability>
  <Capability Min="145" Max="149" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="150" Max="164" Preset="StrobeRandomFastToSlow">Strobe 6: random closing pulse (fast -&gt; slow)</Capability>
  <Capability Min="165" Max="169" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="170" Max="184" Preset="StrobeFastToSlow">Strobe 7: burst pulse (fast -&gt; slow)</Capability>
  <Capability Min="185" Max="189" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="190" Max="204" Preset="StrobeRandomFastToSlow">Strobe 8: random burst pulse (fast -&gt; slow)</Capability>
  <Capability Min="205" Max="209" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="210" Max="224" Preset="StrobeFastToSlow">Strobe 9: sine wave (fast -&gt; slow)</Capability>
  <Capability Min="225" Max="229" Preset="ShutterOpen">Shutter open</Capability>
  <Capability Min="230" Max="244" Preset="StrobeFastToSlow">Strobe 10: burst (fast -&gt; slow)</Capability>
  <Capability Min="245" Max="255" Preset="ShutterOpen">Shutter open</Capability>
 </Channel>
 <Channel Name="CCT">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="9" Preset="NoFunction">No function</Capability>
  <Capability Min="10" Max="255" Preset="ColorCTOMixer">8000K - 2000K</Capability>
 </Channel>
 <Channel Name="Color wheel">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="4" Preset="NoFunction">No function</Capability>
  <Capability Min="5" Max="255" Preset="ColorWheel">Color wheel rotation effect</Capability>
 </Channel>
 <Channel Name="Auto program">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="9" Preset="NoFunction">No function</Capability>
  <Capability Min="10" Max="19">Auto program 1</Capability>
  <Capability Min="20" Max="29">Auto program 2</Capability>
  <Capability Min="30" Max="39">Auto program 3</Capability>
  <Capability Min="40" Max="49">Auto program 4</Capability>
  <Capability Min="50" Max="59">Auto program 5</Capability>
  <Capability Min="60" Max="69">Auto program 6</Capability>
  <Capability Min="70" Max="79">Auto program 7</Capability>
  <Capability Min="80" Max="89">Auto program 8</Capability>
  <Capability Min="90" Max="99">Auto program 9</Capability>
  <Capability Min="100" Max="109">Auto program 10 (cycles 1-10)</Capability>
  <Capability Min="110" Max="119">Custom program 1</Capability>
  <Capability Min="120" Max="129">Custom program 2</Capability>
  <Capability Min="130" Max="139">Custom program 3</Capability>
  <Capability Min="140" Max="149">Custom program 4</Capability>
  <Capability Min="150" Max="159">Custom program 5</Capability>
  <Capability Min="160" Max="169">Custom program 6</Capability>
  <Capability Min="170" Max="179">Custom program 7</Capability>
  <Capability Min="180" Max="189">Custom program 8</Capability>
  <Capability Min="190" Max="199">Custom program 9</Capability>
  <Capability Min="200" Max="255">Custom program 10</Capability>
 </Channel>
 <Channel Name="Speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="0" Preset="NoFunction">No function</Capability>
  <Capability Min="1" Max="255" Preset="SlowToFast">Auto speed or dimmer speed</Capability>
 </Channel>
 <Channel Name="Function set">
  <Group Byte="0">Maintenance</Group>
  <!-- Every setting below must be held for 3 seconds before it takes effect, so a
       scene that sweeps through this channel cannot trigger one by accident. -->
  <Capability Min="0" Max="94" Preset="NoFunction">No function</Capability>
  <Capability Min="95" Max="99">Manual calibration output mode (hold 3 s)</Capability>
  <Capability Min="100" Max="104">Raw color output mode (hold 3 s)</Capability>
  <Capability Min="105" Max="109" Preset="NoFunction">No function</Capability>
  <Capability Min="110" Max="114">Normal dimming, speed of changes unrestricted (hold 3 s)</Capability>
  <Capability Min="115" Max="119" Preset="NoFunction">No function</Capability>
  <Capability Min="120" Max="124">Smooth dimming, speed of changes restricted slightly (hold 3 s)</Capability>
  <Capability Min="125" Max="129" Preset="NoFunction">No function</Capability>
  <Capability Min="130" Max="134">600 Hz refresh rate (hold 3 s)</Capability>
  <Capability Min="135" Max="139">1200 Hz refresh rate (hold 3 s)</Capability>
  <Capability Min="140" Max="144">2400 Hz refresh rate (hold 3 s)</Capability>
  <Capability Min="145" Max="149">4800 Hz refresh rate (hold 3 s)</Capability>
  <Capability Min="150" Max="249" Preset="NoFunction">No function</Capability>
  <Capability Min="250" Max="255">Illuminate display</Capability>
 </Channel>
 <Channel Name="Hue" Preset="IntensityHue"/>
 <Channel Name="Saturation" Preset="IntensitySaturation"/>
 <Channel Name="Value" Preset="IntensityValue"/>
 <Channel Name="Intensity" Preset="IntensityDimmer"/>
 <Mode Name="4 Channel">
  <Channel Number="0">Red</Channel>
  <Channel Number="1">Green</Channel>
  <Channel Number="2">Blue</Channel>
  <Channel Number="3">White</Channel>
 </Mode>
 <Mode Name="6 Channel">
  <Channel Number="0">Dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">White</Channel>
  <Channel Number="5">Shutter</Channel>
 </Mode>
 <Mode Name="7 Channel">
  <Channel Number="0">Dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">White</Channel>
  <Channel Number="5">Shutter</Channel>
  <Channel Number="6">CCT</Channel>
 </Mode>
 <Mode Name="11 Channel">
  <Channel Number="0">Dimmer</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">White</Channel>
  <Channel Number="5">Shutter</Channel>
  <Channel Number="6">CCT</Channel>
  <Channel Number="7">Color wheel</Channel>
  <Channel Number="8">Auto program</Channel>
  <Channel Number="9">Speed</Channel>
  <Channel Number="10">Function set</Channel>
 </Mode>
 <Mode Name="HSV">
  <Channel Number="0">Hue</Channel>
  <Channel Number="1">Saturation</Channel>
  <Channel Number="2">Value</Channel>
 </Mode>
 <Mode Name="HSI">
  <Channel Number="0">Hue</Channel>
  <Channel Number="1">Saturation</Channel>
  <Channel Number="2">Intensity</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="3.8" Width="179" Height="290" Depth="259"/>
  <Lens Name="Other" DegreesMin="15" DegreesMax="15"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="105" DmxConnector="5-pin IP65"/>
 </Physical>
</FixtureDefinition>
