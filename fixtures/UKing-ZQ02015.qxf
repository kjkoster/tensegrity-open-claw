<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.0.0 Beta 3</Version>
  <Author>Yestalgia</Author>
 </Creator>
 <Manufacturer>UKing</Manufacturer>
 <Model>ZQ02015</Model>
 <Type>Moving Head</Type>
 <Channel Name="Pan" Preset="PositionPan"/>
 <Channel Name="Pan Fine" Preset="PositionPanFine"/>
 <Channel Name="Tilt" Preset="PositionTilt"/>
 <Channel Name="Tilt Fine" Preset="PositionTiltFine"/>
 <Channel Name="Color">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="9" Preset="ColorMacro" Res1="#ffffff">White</Capability>
  <Capability Min="10" Max="19" Preset="ColorMacro" Res1="#ff0000">Red</Capability>
  <Capability Min="20" Max="29" Preset="ColorMacro" Res1="#ffff00">Yellow</Capability>
  <Capability Min="30" Max="39" Preset="ColorMacro" Res1="#0000ff">Blue</Capability>
  <Capability Min="40" Max="49" Preset="ColorMacro" Res1="#00ff00">Green</Capability>
  <Capability Min="50" Max="59" Preset="ColorMacro" Res1="#ff8000">Orange</Capability>
  <Capability Min="60" Max="69" Preset="ColorMacro" Res1="#ff69b4">Pink</Capability>
  <Capability Min="70" Max="79" Preset="ColorMacro" Res1="#87cefa">Light Blue</Capability>
  <Capability Min="80" Max="89" Preset="ColorDoubleMacro" Res1="#ff69b4" Res2="#87cefa">Pink + Light Blue</Capability>
  <Capability Min="90" Max="99" Preset="ColorDoubleMacro" Res1="#ff8000" Res2="#ff69b4">Orange + Pink</Capability>
  <Capability Min="100" Max="109" Preset="ColorDoubleMacro" Res1="#00ff00" Res2="#ff8000">Green + Orange</Capability>
  <Capability Min="110" Max="119" Preset="ColorDoubleMacro" Res1="#0000ff" Res2="#00ff00">Blue + Green</Capability>
  <Capability Min="120" Max="129" Preset="ColorDoubleMacro" Res1="#ffff00" Res2="#0000ff">Yellow + Blue</Capability>
  <Capability Min="130" Max="139" Preset="ColorDoubleMacro" Res1="#ff0000" Res2="#ffff00">Red + Yellow</Capability>
  <Capability Min="140" Max="255" Preset="SlowToFast">Automatic Color Change</Capability>
 </Channel>
 <Channel Name="Gobo">
  <Group Byte="0">Gobo</Group>
  <!-- Within a shaking band, higher shakes faster. -->
  <Capability Min="0" Max="7">Open</Capability>
  <Capability Min="8" Max="15">Petals</Capability>
  <Capability Min="16" Max="23">Dots</Capability>
  <Capability Min="24" Max="31">Virus</Capability>
  <Capability Min="32" Max="39">Star Flower</Capability>
  <Capability Min="40" Max="47">Triangles</Capability>
  <Capability Min="48" Max="55">Rose</Capability>
  <Capability Min="56" Max="63">Twister</Capability>
  <Capability Min="64" Max="71">Circle</Capability>
  <Capability Min="72" Max="79">Shaking Petals</Capability>
  <Capability Min="80" Max="87">Shaking Dots</Capability>
  <Capability Min="88" Max="95">Shaking Virus</Capability>
  <Capability Min="96" Max="103">Shaking Star Flower</Capability>
  <Capability Min="104" Max="111">Shaking Triangles</Capability>
  <Capability Min="112" Max="119">Shaking Rose</Capability>
  <Capability Min="120" Max="127">Shaking Twister</Capability>
  <Capability Min="128" Max="255" Preset="SlowToFast">Automatic Rotation</Capability>
 </Channel>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <!-- At 0 the shutter is open. Nothing above 0 is declared yet, because the manual gives
       this channel as a bare 0–255 with no breakdown. -->
  <Capability Min="0" Max="0" Preset="ShutterOpen">Shutter open</Capability>
 </Channel>
 <Channel Name="Dimmer">
  <!-- The head stays dark all the way up to 43. -->
  <Group Byte="0">Intensity</Group>
  <Capability Min="0" Max="43">Off</Capability>
  <Capability Min="44" Max="255">Level</Capability>
 </Channel>
 <Channel Name="Automatic Mode">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="59" Preset="NoFunction">Other channels function</Capability>
  <Capability Min="60" Max="84">Automatic Mode 3</Capability>
  <Capability Min="85" Max="109">Automatic Mode 2</Capability>
  <Capability Min="110" Max="134">Automatic Mode 1</Capability>
  <Capability Min="135" Max="159">Automatic Mode 0</Capability>
  <Capability Min="160" Max="184">Voice Control Mode 3</Capability>
  <Capability Min="185" Max="209">Voice Control Mode2</Capability>
  <Capability Min="210" Max="234">Voice Control Mode 1</Capability>
  <Capability Min="235" Max="255">Voice Control Mode 0</Capability>
 </Channel>
 <Channel Name="Reset">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="249" Preset="NoFunction">No Function</Capability>
  <Capability Min="250" Max="255">Reset (hold 5s)</Capability>
 </Channel>
 <Channel Name="Light Strips">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="4" Preset="NoFunction">Off</Capability>
  <Capability Min="5" Max="109">Color Selection</Capability>
  <Capability Min="110" Max="255">Color Auto Operation</Capability>
 </Channel>
 <!-- Fast to slow, the opposite way round from most heads: 0 is the fastest the motors will
      move and 255 the slowest. -->
 <Channel Name="Motor Speed" Preset="SpeedPanTiltFastSlow"/>
 <Mode Name="12 Channel">
  <Channel Number="0">Pan</Channel>
  <Channel Number="1">Pan Fine</Channel>
  <Channel Number="2">Tilt</Channel>
  <Channel Number="3">Tilt Fine</Channel>
  <Channel Number="4">Color</Channel>
  <Channel Number="5">Gobo</Channel>
  <Channel Number="6">Strobe</Channel>
  <Channel Number="7">Dimmer</Channel>
  <Channel Number="8">Motor Speed</Channel>
  <Channel Number="9">Automatic Mode</Channel>
  <Channel Number="10">Reset</Channel>
  <Channel Number="11">Light Strips</Channel>
 </Mode>
 <Mode Name="10 Channel">
  <Channel Number="0">Pan</Channel>
  <Channel Number="1">Tilt</Channel>
  <Channel Number="2">Color</Channel>
  <Channel Number="3">Gobo</Channel>
  <Channel Number="4">Strobe</Channel>
  <Channel Number="5">Dimmer</Channel>
  <Channel Number="6">Motor Speed</Channel>
  <Channel Number="7">Automatic Mode</Channel>
  <Channel Number="8">Reset</Channel>
  <Channel Number="9">Light Strips</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="5" ColourTemperature="3000"/>
  <Dimensions Weight="2.92" Width="81" Height="57" Depth="113"/>
  <Lens Name="Other" DegreesMin="11" DegreesMax="11"/>
  <Focus Type="Head" PanMax="540" TiltMax="180"/>
  <Technical PowerConsumption="50" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
