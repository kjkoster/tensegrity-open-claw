{
  "HOST_INFO": {
    "NAME": "memory",
    "OSC_TRANSPORT": "UDP",
    "CLOCKWORK_CHAOS_IMPLEMENTS": ["health", "sys", "wifi"]
  },
  "FULL_PATH": "/",
  "DESCRIPTION": "Memory, the daemon on chaos-pi that records the OSC every device sends into GreptimeDB and relays it onto MQTT. It hands its own OSC to itself rather than sending it, so it is recorded while the WiFi is down. Sent on connect means once, as soon as the clock has synchronised, which is when it can be recorded.",
  "CONTENTS": {
    "sys": {
      "FULL_PATH": "/sys",
      "DESCRIPTION": "What each device runs on, under its own name.",
      "CONTENTS": {
        "memory": {
          "FULL_PATH": "/sys/memory",
          "DESCRIPTION": "The Pi Memory runs on, and how it is holding up, as Memory reads it.",
          "CONTENTS": {
            "ram": {
              "FULL_PATH": "/sys/memory/ram",
              "DESCRIPTION": "The RAM fitted, from the board's revision code; not what the kernel is left after the GPU's share.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["MB"],
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            },
            "temperature": {
              "FULL_PATH": "/sys/memory/temperature",
              "DESCRIPTION": "The SoC's temperature.",
              "TYPE": "f",
              "ACCESS": 1,
              "UNIT": ["°C"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
            },
            "throttling": {
              "FULL_PATH": "/sys/memory/throttling",
              "DESCRIPTION": "The firmware's throttling word, as vcgencmd get_throttled gives it.",
              "CONTENTS": {
                "raw": {
                  "FULL_PATH": "/sys/memory/throttling/raw",
                  "DESCRIPTION": "The word as read, for the bits the flags below do not name.",
                  "TYPE": "i",
                  "ACCESS": 1,
                  "RANGE": [{ "MIN": 0 }],
                  "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
                },
                "now": {
                  "FULL_PATH": "/sys/memory/throttling/now",
                  "DESCRIPTION": "What is happening at this moment.",
                  "CONTENTS": {
                    "under_voltage": {
                      "FULL_PATH": "/sys/memory/throttling/now/under_voltage",
                      "DESCRIPTION": "The supply is below what the board needs.",
                      "TYPE": "T",
                      "ACCESS": 1,
                      "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
                    },
                    "arm_capped": {
                      "FULL_PATH": "/sys/memory/throttling/now/arm_capped",
                      "DESCRIPTION": "The CPU's clock is capped.",
                      "TYPE": "T",
                      "ACCESS": 1,
                      "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
                    },
                    "throttled": {
                      "FULL_PATH": "/sys/memory/throttling/now/throttled",
                      "DESCRIPTION": "The CPU is throttled.",
                      "TYPE": "T",
                      "ACCESS": 1,
                      "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
                    },
                    "soft_temp_limit": {
                      "FULL_PATH": "/sys/memory/throttling/now/soft_temp_limit",
                      "DESCRIPTION": "The soft temperature limit is active.",
                      "TYPE": "T",
                      "ACCESS": 1,
                      "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
                    }
                  }
                },
                "since_boot": {
                  "FULL_PATH": "/sys/memory/throttling/since_boot",
                  "DESCRIPTION": "What has happened at any time since boot: the brownout nobody was watching for. Each is logged the first time it is seen.",
                  "CONTENTS": {
                    "under_voltage": {
                      "FULL_PATH": "/sys/memory/throttling/since_boot/under_voltage",
                      "DESCRIPTION": "The supply has been below what the board needs.",
                      "TYPE": "T",
                      "ACCESS": 1,
                      "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
                    },
                    "arm_capped": {
                      "FULL_PATH": "/sys/memory/throttling/since_boot/arm_capped",
                      "DESCRIPTION": "The CPU's clock has been capped.",
                      "TYPE": "T",
                      "ACCESS": 1,
                      "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
                    },
                    "throttled": {
                      "FULL_PATH": "/sys/memory/throttling/since_boot/throttled",
                      "DESCRIPTION": "The CPU has been throttled.",
                      "TYPE": "T",
                      "ACCESS": 1,
                      "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
                    },
                    "soft_temp_limit": {
                      "FULL_PATH": "/sys/memory/throttling/since_boot/soft_temp_limit",
                      "DESCRIPTION": "The soft temperature limit has been active.",
                      "TYPE": "T",
                      "ACCESS": 1,
                      "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
                    }
                  }
                }
              }
            },
            "mem_total": {
              "FULL_PATH": "/sys/memory/mem_total",
              "DESCRIPTION": "The RAM the kernel has, MemTotal.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["MB"],
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            },
            "disk_free": {
              "FULL_PATH": "/sys/memory/disk_free",
              "DESCRIPTION": "Free space on the SD card, for an unprivileged user.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["MB"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
            },
            "tank_free": {
              "FULL_PATH": "/sys/memory/tank_free",
              "DESCRIPTION": "Free space on the SSD the recordings are on, at /tank. NaN while it is not mounted, so the SD card's free space under the empty mount point never reads as the SSD's.",
              "TYPE": "f",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["MB"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 1
            }
          }
        }
      }
    }
  }
}
