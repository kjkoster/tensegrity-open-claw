{
  "HOST_INFO": {
    "NAME": "wrist",
    "OSC_TRANSPORT": "UDP"
  },
  "FULL_PATH": "/",
  "CONTENTS": {
    "wrist": {
      "FULL_PATH": "/wrist",
      "DESCRIPTION": "Wrist, a guy-wire drive that phase-locks to the structure's sway and pumps it at resonance. It is driven over DMX, in wrist.qxf; this is what it reports. Out only: nothing is received over OSC. Only loop variables and raw inputs are sent; anything derived is derived from the recording.",
      "CONTENTS": {
        "mode": {
          "FULL_PATH": "/wrist/mode",
          "DESCRIPTION": "The mode Wrist is in: the frame's, or blackout while it has no live frame.",
          "TYPE": "s",
          "ACCESS": 1,
          "RANGE": [
            { "VALS": ["blackout", "hold", "pluck", "run", "manual"] }
          ],
          "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
        },
        "run": {
          "FULL_PATH": "/wrist/run",
          "DESCRIPTION": "Run's sine, x0 + s·A·sin φ.",
          "CONTENTS": {
            "phase": {
              "FULL_PATH": "/wrist/run/phase",
              "DESCRIPTION": "φ, from 0 as Run begins, the end of the first swing at π/2. NaN outside Run.",
              "TYPE": "f",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0, "MAX": 6.2831855 }],
              "UNIT": ["rad"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
            }
          }
        },
        "pluck": {
          "FULL_PATH": "/wrist/pluck",
          "DESCRIPTION": "Whether a pluck can be started: busy from Pluck's start until the shaft is back where it began; can in Hold, where Pluck in the next frame tugs; cannot at every other time, Pluck after its return included.",
          "TYPE": "s",
          "ACCESS": 1,
          "RANGE": [
            { "VALS": ["cannot", "can", "busy"] }
          ],
          "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
        },
        "alarm": {
          "FULL_PATH": "/wrist/alarm",
          "DESCRIPTION": "",
          "TYPE": "T",
          "ACCESS": 1,
          "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
        },
        "load": {
          "FULL_PATH": "/wrist/load",
          "DESCRIPTION": "The load cell under the motor, reading the wire's tension.",
          "CONTENTS": {
            "force": {
              "FULL_PATH": "/wrist/load/force",
              "DESCRIPTION": "The wire's tension, from the raw reading through the coded-in tare and scale.",
              "TYPE": "f",
              "ACCESS": 1,
              "UNIT": ["N"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
            },
            "raw": {
              "FULL_PATH": "/wrist/load/raw",
              "DESCRIPTION": "Each HX711 reading as read, sent once when it arrives: 10 a second, 80 once the RATE leg is lifted.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": -8388608, "MAX": 8388607 }],
              "UNIT": ["count"],
              "CLOCKWORK_CHAOS_ON_EVENT": "data"
            },
            "tare": {
              "FULL_PATH": "/wrist/load/tare",
              "DESCRIPTION": "The coded-in tare: the raw reading with no tension on the wire.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": -8388608, "MAX": 8388607 }],
              "UNIT": ["count"],
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            },
            "scale": {
              "FULL_PATH": "/wrist/load/scale",
              "DESCRIPTION": "The coded-in scale: the tension one count above the tare stands for, so the force is (raw − tare) · scale. NaN until it is measured.",
              "TYPE": "f",
              "ACCESS": 1,
              "UNIT": ["N/count"],
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            }
          }
        },
        "health": {
          "FULL_PATH": "/wrist/health",
          "CONTENTS": {
            "tick_dt": {
              "FULL_PATH": "/wrist/health/tick_dt",
              "DESCRIPTION": "The longest interval between control ticks since the last bundle.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["µs"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
            }
          }
        }
      }
    },
    "dmx": {
      "FULL_PATH": "/dmx",
      "CONTENTS": {
        "wrist": {
          "FULL_PATH": "/dmx/wrist",
          "DESCRIPTION": "Where Wrist sits on the rig's universe, as the patch says, and how fresh its frames are.",
          "CONTENTS": {
            "universe": {
              "FULL_PATH": "/dmx/wrist/universe",
              "DESCRIPTION": "The sACN universe Wrist listens to.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 1, "MAX": 63999 }],
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            },
            "address": {
              "FULL_PATH": "/dmx/wrist/address",
              "DESCRIPTION": "Wrist's DMX start address.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 1, "MAX": 512 }],
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            },
            "port": {
              "FULL_PATH": "/dmx/wrist/port",
              "DESCRIPTION": "The UDP port Wrist listens on for sACN.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 1, "MAX": 65535 }],
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            },
            "sacn_age": {
              "FULL_PATH": "/dmx/wrist/sacn_age",
              "DESCRIPTION": "How long ago the last frame of the universe arrived.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["ms"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
            },
            "sacn_packets": {
              "FULL_PATH": "/dmx/wrist/sacn_packets",
              "DESCRIPTION": "Every datagram on the sACN port since boot, the universe's frames or not. Packets counting up while frames do not are packets that are not Wrist's.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["count"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
            },
            "sacn_frames": {
              "FULL_PATH": "/dmx/wrist/sacn_frames",
              "DESCRIPTION": "Every frame of the universe taken since boot.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["count"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
            },
            "sacn_skipped": {
              "FULL_PATH": "/dmx/wrist/sacn_skipped",
              "DESCRIPTION": "Frames the sender's sequence numbers say were sent and never arrived, since boot. Not counted across a lost universe.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["count"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
            }
          }
        }
      }
    },
    "sys": {
      "FULL_PATH": "/sys",
      "DESCRIPTION": "What each device runs on, under its own name.",
      "CONTENTS": {
        "wrist": {
          "FULL_PATH": "/sys/wrist",
          "DESCRIPTION": "What Wrist runs on, and how its link and its chip are doing.",
          "CONTENTS": {
            "uptime": {
              "FULL_PATH": "/sys/wrist/uptime",
              "DESCRIPTION": "Time since the chip started, so a restart shows in the recording at once. Starts again from 0 every 49.7 days, when the chip's millisecond clock wraps.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["s"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
            },
            "heap_free": {
              "FULL_PATH": "/sys/wrist/heap_free",
              "DESCRIPTION": "Free heap.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["byte"],
              "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
            },
            "wifi": {
              "FULL_PATH": "/sys/wrist/wifi",
              "DESCRIPTION": "Wrist's end of the WiFi link. Stem reports the other end, how strongly the access point hears Wrist, on MQTT.",
              "CONTENTS": {
                "rssi": {
                  "FULL_PATH": "/sys/wrist/wifi/rssi",
                  "DESCRIPTION": "How strongly Wrist hears the access point.",
                  "TYPE": "i",
                  "ACCESS": 1,
                  "RANGE": [{ "MAX": 0 }],
                  "UNIT": ["dBm"],
                  "CLOCKWORK_CHAOS_AT_RATE_HZ": 10
                },
                "channel": {
                  "FULL_PATH": "/sys/wrist/wifi/channel",
                  "DESCRIPTION": "The channel joined.",
                  "TYPE": "i",
                  "ACCESS": 1,
                  "RANGE": [{ "MIN": 1, "MAX": 14 }],
                  "CLOCKWORK_CHAOS_ON_EVENT": "connect"
                },
                "bssid": {
                  "FULL_PATH": "/sys/wrist/wifi/bssid",
                  "DESCRIPTION": "The access point joined, its MAC address as six colon-separated hex pairs.",
                  "TYPE": "s",
                  "ACCESS": 1,
                  "CLOCKWORK_CHAOS_ON_EVENT": "connect"
                },
                "disconnects": {
                  "FULL_PATH": "/sys/wrist/wifi/disconnects",
                  "DESCRIPTION": "Disconnects since boot, each failed attempt to join again among them.",
                  "TYPE": "i",
                  "ACCESS": 1,
                  "RANGE": [{ "MIN": 0 }],
                  "UNIT": ["count"],
                  "CLOCKWORK_CHAOS_ON_EVENT": "connect"
                },
                "disconnect_reason": {
                  "FULL_PATH": "/sys/wrist/wifi/disconnect_reason",
                  "DESCRIPTION": "Why the last disconnect happened, as the WiFi stack gave it; none before the first.",
                  "TYPE": "s",
                  "ACCESS": 1,
                  "RANGE": [
                    { "VALS": ["none", "unspecified", "auth_expired", "deauth_leaving", "inactivity", "ap_busy", "not_authenticated", "not_associated", "left", "four_way_handshake_timeout", "group_key_timeout", "auth_failed_8021x", "beacon_timeout", "no_ap_found", "auth_failed", "assoc_failed", "handshake_timeout", "other"] }
                  ],
                  "CLOCKWORK_CHAOS_ON_EVENT": "connect"
                }
              }
            },
            "mac": {
              "FULL_PATH": "/sys/wrist/mac",
              "DESCRIPTION": "The WiFi station's MAC address, as six colon-separated hex pairs.",
              "TYPE": "s",
              "ACCESS": 1,
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            },
            "ip": {
              "FULL_PATH": "/sys/wrist/ip",
              "DESCRIPTION": "The WiFi station's IPv4 address, in dotted-quad form.",
              "TYPE": "s",
              "ACCESS": 1,
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            },
            "reset_reason": {
              "FULL_PATH": "/sys/wrist/reset_reason",
              "DESCRIPTION": "Why the chip last started.",
              "TYPE": "s",
              "ACCESS": 1,
              "RANGE": [
                { "VALS": ["power_on", "hardware_watchdog", "exception", "software_watchdog", "software_restart", "deep_sleep_wake", "external_reset"] }
              ],
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            },
            "flash_size": {
              "FULL_PATH": "/sys/wrist/flash_size",
              "DESCRIPTION": "The flash chip's real size, as the chip reports it, not as the build assumed.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "MIN": 0 }],
              "UNIT": ["byte"],
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            },
            "cpu_freq": {
              "FULL_PATH": "/sys/wrist/cpu_freq",
              "DESCRIPTION": "The CPU's clock.",
              "TYPE": "i",
              "ACCESS": 1,
              "RANGE": [{ "VALS": [80, 160] }],
              "UNIT": ["MHz"],
              "CLOCKWORK_CHAOS_ON_EVENT": "connect"
            }
          }
        }
      }
    }
  }
}
