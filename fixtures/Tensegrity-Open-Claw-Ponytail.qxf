<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.2.1</Version>
  <Author>Kees Jan Koster</Author>
 </Creator>
 <Manufacturer>Tensegrity Open Claw</Manufacturer>
 <Model>Ponytail</Model>
 <Type>Color Changer</Type>
 <!-- A fibre-optic fixture retrofitted with an ESP32-S3 that receives sACN over WiFi.
      The channel layout is defined by our own firmware, not by a vendor: see
      ponytail/src/models.rs (DmxValue) and README.md "Interlocked white".

      Two behaviours cannot be expressed in a fixture definition, so they are recorded
      here instead:

      * White and RGB are INTERLOCKED. The fixture's hardware cannot light the RGB
        emitters and the white LED together, so while White > 0 the Red/Green/Blue
        channels are ignored, and colour-to-white is a hard cut rather than a fade.
        QLC+ will happily let you raise White and Blue together; the rig will not.
      * Intensity is applied in software and at 0 it powers the LED off entirely,
        which also stops the gobo motor (a hardware coupling). -->
 <Channel Name="Intensity" Preset="IntensityMasterDimmer"/>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="Gobo rotation">
  <Group Byte="0">Gobo</Group>
  <Capability Min="0" Max="0" Preset="RotationStop">Motor off</Capability>
  <Capability Min="1" Max="255" Preset="RotationClockwiseSlowToFast">Rotation, slow -&gt; fast</Capability>
 </Channel>
 <!-- One rotation channel and no gobo-select channel: the plate is fixed and the
      fixture ignores gobo selection entirely. -->
 <Mode Name="6 Channel">
  <Channel Number="0">Intensity</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">White</Channel>
  <Channel Number="5">Gobo rotation</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="0" Width="0" Height="0" Depth="0"/>
  <Lens Name="Other" DegreesMin="0" DegreesMax="0"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="24" DmxConnector="Wireless"/>
 </Physical>
</FixtureDefinition>
