# The rig's WiFi, defined once. Both Pis' deploys read this file and fill its values into their
# NetworkManager profiles — claw-pi's access point and memory-pi's connection to it — so the
# two cannot disagree. A change here reaches both on their next deploy.
CLAW_SSID="closed claw DMX"
CLAW_PSK="close-that-claw"
# Fixed rather than chosen at start, so the clients look for the access point on this channel
# alone and find it faster.
CLAW_CHANNEL=6
