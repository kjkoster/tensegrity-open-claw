[Unit]
Description=Tensegrity Stem Health Daemon
# Ordered after the network so that its goodbye leaves before the network goes. Nothing waits
# for the broker: a broker that is down must leave Stem running and publishing nothing,
# because a health daemon that exits when the transport fails is silent in precisely the
# situation it exists for.
After=network.target

[Service]
# Its own venv, not a shared one. Stem must not inherit another daemon's dependencies — it has to
# keep reporting when that daemon is exactly what has gone wrong.
ExecStart=/opt/stem/venv/bin/python3 /usr/local/bin/stem.py
# The broker is Stem's, but runs on memory-pi, at the address it sets itself on the access
# point.
Environment=RIG_MQTT_HOST=10.0.10.2
Restart=always
RestartSec=5
# No WatchdogSec, and Stem pets nothing. Its death costs telemetry and must never cost uptime,
# so it is given no mechanism that could take anything else down with it.
#
# No real-time scheduling either, and a positive Nice on top: everything this daemon reads is
# slow-moving, and none of it is worth a single late DMX frame.
Nice=10
# Every core but one, so core 3 is always free of a health daemon waking every thirty seconds.
# The brain pins nothing itself (see brain.service), so this keeps a core quieter for its
# real-time threads rather than reserving one for them.
CPUAffinity=0 1 2

[Install]
WantedBy=multi-user.target
