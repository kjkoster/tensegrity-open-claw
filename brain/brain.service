[Unit]
Description=Tensegrity Brain Daemon
# Ordered after the broker and the network so that systemd stops the brain first: a broker or
# a network taken down ahead of the brain would leave its goodbye unsaid and an orderly reboot
# reading as a crash. Ordered only: nothing waits for the broker, and one that is down or not
# up yet costs telemetry and never the show.
After=network.target mosquitto.service

[Service]
ExecStart=/usr/local/bin/brain
Restart=always
RestartSec=5
# Deliberately no CPUSchedulingPolicy or CPUAffinity: each thread sets its own core and
# priority from inside the process (cortex's `sched`), because the frame loop and the threads
# beside it need opposite things, and a unit file can only say one thing about the whole
# process.

[Install]
WantedBy=multi-user.target
