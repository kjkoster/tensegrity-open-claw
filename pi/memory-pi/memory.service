[Unit]
Description=Tensegrity Memory Health Daemon
# Wanted, not Required: a broker that is down must leave the daemon running and publishing
# nothing, because a health daemon that exits when the transport fails is silent in precisely
# the situation it exists for. Ordered after it so that its goodbye reaches the broker before
# the broker stops.
Wants=mosquitto.service
After=mosquitto.service

[Service]
# Its own venv, not a shared one, so it keeps reporting when the recorder's dependencies are
# what has gone wrong. The broker is on this Pi, so the client's loopback default is right.
ExecStart=/opt/memory/venv/bin/python3 /usr/local/bin/memory.py
Restart=always
RestartSec=5
# A positive Nice, as Stem's: everything this reads is slow-moving.
Nice=10

[Install]
WantedBy=multi-user.target
