# memory-pi's connection to chaos-pi's access point, as a NetworkManager profile. A template:
# deploy-memory-pi.sh fills the @…@ placeholders from memory_pi's wlan0 in clockwork.dot
# (clockwork/pi_network.py), and the deploy installs the result.

[connection]
id=claw
type=wifi
interface-name=wlan0
# Above the profile Raspberry Pi Imager writes for the same network, which every fresh install
# has, so this one is chosen without the deploy having to remove that one.
autoconnect-priority=10
# Never give up: both Pis power up together and memory-pi is up long before the access point.
autoconnect-retries=0

[wifi]
ssid=@WLAN0_SSID@
band=bg
channel=@WLAN0_CHANNEL@

[wifi-security]
key-mgmt=wpa-psk
psk=@WLAN0_PSK@

[ipv4]
method=manual
address1=@WLAN0_ADDRESS@,@WLAN0_GATEWAY@
# The gateway is chaos-pi, whose access point relays DNS.
dns=@WLAN0_GATEWAY@;

[ipv6]
method=disabled
