[Unit]
Description=Tensegrity Memory Recorder
# Wanted, not Required, both of them: with Greptime down the recorder holds what it receives
# and keeps reporting why it cannot write, and with the broker down it waits and reconnects,
# rather than vanishing along with either.
Wants=greptimedb.service mosquitto.service
After=greptimedb.service mosquitto.service

[Service]
# Its own venv, apart from the health daemon's. The broker is on this Pi, so the client's
# loopback default is right.
ExecStart=/opt/recorder/venv/bin/python3 /usr/local/bin/recorder.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
