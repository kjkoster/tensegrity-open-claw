[Unit]
Description=GreptimeDB, Memory's time-series database
# Not without the SSD: started on an empty /tank, it would write into the mount point and fill
# the SD card.
RequiresMountsFor=/tank

[Service]
ExecStart=/opt/greptimedb/greptime standalone start -c /etc/greptimedb/greptimedb.toml
# Its own unprivileged user, owning nothing but its data directory on the SSD.
User=greptime
Group=greptime
Restart=always
RestartSec=5
# The broker comes first on a 1 GB Pi. When memory runs out, the kernel kills Greptime before
# the broker: no memory cap is possible, because the Pi's kernel ships with the memory cgroup
# controller off. Its disk waits on everyone else's, and its CPU comes after the broker's and
# the health daemon's.
OOMScoreAdjust=500
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
