[Unit]
Description=Tensegrity Memory
# Wanted, not Required: with the broker down Memory keeps recording, and with GreptimeDB down it
# holds what it receives and keeps relaying, rather than vanishing along with either. Ordered
# after both, so its goodbye reaches the broker before the broker stops.
Wants=mosquitto.service greptimedb.service
After=mosquitto.service greptimedb.service

[Service]
ExecStart=/usr/local/bin/memory
Restart=always
RestartSec=5
# The brain comes first, then Memory, then GreptimeDB. Behind the brain's frame loop in CPU, and
# killed before the brain and after GreptimeDB when memory runs out: no memory cap is possible,
# because the Pi's kernel ships with the memory cgroup controller off.
Nice=5
OOMScoreAdjust=200

[Install]
WantedBy=multi-user.target
