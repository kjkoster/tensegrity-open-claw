# chaos-pi's wired segment, as a NetworkManager profile: a laptop when one is plugged in. A
# template: deploy-chaos-pi.sh fills the @…@ placeholders from chaos_pi's eth0 in
# clockwork.dot (clockwork/pi_network.py), and the deploy installs the result.

[connection]
id=claw-eth0
type=ethernet
interface-name=eth0
# Above any profile the image or NetworkManager itself makes for eth0, so this one is chosen
# without the deploy having to remove those.
autoconnect-priority=10

[ipv4]
# Shared, as on the access point: DHCP for a laptop on the wire, routed out like every other
# client.
method=shared
address1=@ETH0_ADDRESS@
shared-dhcp-range=@ETH0_DHCP_RANGE@

[ipv6]
method=disabled
